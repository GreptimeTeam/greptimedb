-- 1. Index metadata written by the old binary must survive.
SHOW CREATE TABLE t_inverted_index_survival;

+---------------------------+----------------------------------------------------------+
| Table                     | Create Table                                             |
+---------------------------+----------------------------------------------------------+
| t_inverted_index_survival | CREATE TABLE IF NOT EXISTS "t_inverted_index_survival" ( |
|                           |   "host" STRING NULL INVERTED INDEX,                     |
|                           |   "msg" STRING NULL INVERTED INDEX,                      |
|                           |   "msg2" STRING NULL,                                    |
|                           |   "ts" TIMESTAMP(3) NOT NULL,                            |
|                           |   "cpu" DOUBLE NULL,                                     |
|                           |   TIME INDEX ("ts"),                                     |
|                           |   PRIMARY KEY ("host")                                   |
|                           | )                                                        |
|                           |                                                          |
|                           | ENGINE=mito                                              |
|                           |                                                          |
+---------------------------+----------------------------------------------------------+

-- 2. Rows written by the old binary must still be readable.
SELECT host, msg, cpu
FROM t_inverted_index_survival
ORDER BY host, ts;

+------+--------------+-----+
| host | msg          | cpu |
+------+--------------+-----+
| h1   | first event  | 1.0 |
| h2   | second event | 2.0 |
+------+--------------+-----+

-- 3. Filtered read on the column indexed by the old binary.
SELECT host, msg
FROM t_inverted_index_survival
WHERE msg = 'first event'
ORDER BY host, ts;

+------+-------------+
| host | msg         |
+------+-------------+
| h1   | first event |
+------+-------------+

-- 4. The new binary must still be able to write into the old table.
INSERT INTO t_inverted_index_survival VALUES
  ('h3', 'third event', 'third note', '2026-07-07 00:02:00+0000', 3.0);

Affected Rows: 1

SELECT host, msg, cpu
FROM t_inverted_index_survival
ORDER BY host, ts;

+------+--------------+-----+
| host | msg          | cpu |
+------+--------------+-----+
| h1   | first event  | 1.0 |
| h2   | second event | 2.0 |
| h3   | third event  | 3.0 |
+------+--------------+-----+

-- 5. Index DDL must still work against the old table.
ALTER TABLE t_inverted_index_survival MODIFY COLUMN msg2 SET INVERTED INDEX;

Affected Rows: 0

SHOW CREATE TABLE t_inverted_index_survival;

+---------------------------+----------------------------------------------------------+
| Table                     | Create Table                                             |
+---------------------------+----------------------------------------------------------+
| t_inverted_index_survival | CREATE TABLE IF NOT EXISTS "t_inverted_index_survival" ( |
|                           |   "host" STRING NULL INVERTED INDEX,                     |
|                           |   "msg" STRING NULL INVERTED INDEX,                      |
|                           |   "msg2" STRING NULL INVERTED INDEX,                     |
|                           |   "ts" TIMESTAMP(3) NOT NULL,                            |
|                           |   "cpu" DOUBLE NULL,                                     |
|                           |   TIME INDEX ("ts"),                                     |
|                           |   PRIMARY KEY ("host")                                   |
|                           | )                                                        |
|                           |                                                          |
|                           | ENGINE=mito                                              |
|                           |                                                          |
+---------------------------+----------------------------------------------------------+

ALTER TABLE t_inverted_index_survival MODIFY COLUMN msg2 UNSET INVERTED INDEX;

Affected Rows: 0

SHOW CREATE TABLE t_inverted_index_survival;

+---------------------------+----------------------------------------------------------+
| Table                     | Create Table                                             |
+---------------------------+----------------------------------------------------------+
| t_inverted_index_survival | CREATE TABLE IF NOT EXISTS "t_inverted_index_survival" ( |
|                           |   "host" STRING NULL INVERTED INDEX,                     |
|                           |   "msg" STRING NULL INVERTED INDEX,                      |
|                           |   "msg2" STRING NULL,                                    |
|                           |   "ts" TIMESTAMP(3) NOT NULL,                            |
|                           |   "cpu" DOUBLE NULL,                                     |
|                           |   TIME INDEX ("ts"),                                     |
|                           |   PRIMARY KEY ("host")                                   |
|                           | )                                                        |
|                           |                                                          |
|                           | ENGINE=mito                                              |
|                           |                                                          |
+---------------------------+----------------------------------------------------------+
