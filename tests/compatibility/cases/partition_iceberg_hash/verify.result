SHOW CREATE TABLE iceberg_hash_routes;

+---------------------+-------------------------------------------------------------+
| Table               | Create Table                                                |
+---------------------+-------------------------------------------------------------+
| iceberg_hash_routes | CREATE TABLE IF NOT EXISTS "iceberg_hash_routes" (          |
|                     |   "host" STRING NULL,                                       |
|                     |   "tenant" BIGINT UNSIGNED NULL,                            |
|                     |   "ts" TIMESTAMP(3) NOT NULL,                               |
|                     |   "v" INT NULL,                                             |
|                     |   TIME INDEX ("ts"),                                        |
|                     |   PRIMARY KEY ("host", "tenant")                            |
|                     | )                                                           |
|                     | PARTITION ON COLUMNS ("host", "tenant") (                   |
|                     |   iceberg_hash("host") < 0 AND "tenant" < 100,              |
|                     |   iceberg_hash("host") < 0 AND "tenant" >= 100,             |
|                     |   iceberg_hash("host") >= 0 AND iceberg_hash("tenant") < 0, |
|                     |   iceberg_hash("host") >= 0 AND iceberg_hash("tenant") >= 0 |
|                     | )                                                           |
|                     | ENGINE=mito                                                 |
|                     |                                                             |
+---------------------+-------------------------------------------------------------+

SELECT * FROM iceberg_hash_routes ORDER BY ts;

+----------+----------------------+-------------------------+---+
| host     | tenant               | ts                      | v |
+----------+----------------------+-------------------------+---+
| a        | 1                    | 1970-01-01T00:00:00.001 | 1 |
| b        | 100                  | 1970-01-01T00:00:00.002 | 2 |
| server42 | 18446744073709551615 | 1970-01-01T00:00:00.003 | 3 |
| 中🙂     | 0                    | 1970-01-01T00:00:00.004 | 4 |
|          | 7                    | 1970-01-01T00:00:00.005 | 5 |
+----------+----------------------+-------------------------+---+

-- Overwrites must route to the regions holding the flushed rows.
INSERT INTO iceberg_hash_routes VALUES
  ('a', 1, 1, 10),
  ('b', 100, 2, 20),
  ('server42', 18446744073709551615, 3, 30),
  ('中🙂', 0, 4, 40),
  (NULL, 7, 5, 50);

Affected Rows: 5

