+------+-------------------------+----+
| abc  | 1970-01-01T00:00:00.001 | 10 |
| xyz  | 1970-01-01T00:00:00.002 | 20 |
| 中🙂 | 1970-01-01T00:00:00.003 | 30 |
|      | 1970-01-01T00:00:00.004 | 40 |
+------+-------------------------+----+

SELECT * FROM function_routes WHERE host = 'abc';

+------+-------------------------+----+
| host | ts                      | v  |
+------+-------------------------+----+
| abc  | 1970-01-01T00:00:00.001 | 10 |
+------+-------------------------+----+

DELETE FROM function_routes WHERE host = 'xyz';

Affected Rows: 1

