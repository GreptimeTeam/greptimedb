SHOW CREATE TABLE function_routes;

+-----------------+------------------------------------------------+
| Table           | Create Table                                   |
+-----------------+------------------------------------------------+
| function_routes | CREATE TABLE IF NOT EXISTS "function_routes" ( |
|                 |   "host" STRING NULL,                          |
|                 |   "ts" TIMESTAMP(3) NOT NULL,                  |
|                 |   "v" INT NULL,                                |
|                 |   TIME INDEX ("ts"),                           |
|                 |   PRIMARY KEY ("host")                         |
|                 | )                                              |
|                 | PARTITION ON COLUMNS ("host") (                |
|                 |   hash(substring("host", 1, 2)) < '8',         |
|                 |   hash(substring("host", 1, 2)) >= '8'         |
|                 | )                                              |
|                 | ENGINE=mito                                    |
|                 |                                                |
+-----------------+------------------------------------------------+

SELECT * FROM function_routes ORDER BY ts;

+------+-------------------------+---+
| host | ts                      | v |
+------+-------------------------+---+
| abc  | 1970-01-01T00:00:00.001 | 1 |
| xyz  | 1970-01-01T00:00:00.002 | 2 |
| 中🙂 | 1970-01-01T00:00:00.003 | 3 |
|      | 1970-01-01T00:00:00.004 | 4 |
+------+-------------------------+---+

INSERT INTO function_routes VALUES ('abc', 1, 10), ('xyz', 2, 20), ('中🙂', 3, 30), (NULL, 4, 40);

Affected Rows: 4

SELECT * FROM function_routes ORDER BY ts;

+------+-------------------------+----+
| host | ts                      | v  |
+------+-------------------------+----+
| abc  | 1970-01-01T00:00:00.001 | 10 |
| xyz  | 1970-01-01T00:00:00.002 | 20 |
| 中🙂 | 1970-01-01T00:00:00.003 | 30 |
|      | 1970-01-01T00:00:00.004 | 40 |
+------+-------------------------+----+

SELECT * FROM function_routes WHERE host = 'abc';

+------+-------------------------+----+
| host | ts                      | v  |
+------+-------------------------+----+
| abc  | 1970-01-01T00:00:00.001 | 10 |
+------+-------------------------+----+

DELETE FROM function_routes WHERE host = 'xyz';

Affected Rows: 1

SELECT * FROM function_routes ORDER BY ts;

+------+-------------------------+----+
| host | ts                      | v  |
+------+-------------------------+----+
| abc  | 1970-01-01T00:00:00.001 | 10 |
| 中🙂 | 1970-01-01T00:00:00.003 | 30 |
|      | 1970-01-01T00:00:00.004 | 40 |
+------+-------------------------+----+

SHOW CREATE TABLE integer_hash_routes;

+---------------------+-----------------------------------------------------------+
| Table               | Create Table                                              |
+---------------------+-----------------------------------------------------------+
| integer_hash_routes | CREATE TABLE IF NOT EXISTS "integer_hash_routes" (        |
|                     |   "tenant_id" BIGINT NULL,                                |
|                     |   "device_id" BIGINT UNSIGNED NULL,                       |
|                     |   "host" STRING NULL,                                     |
|                     |   "ts" TIMESTAMP(3) NOT NULL,                             |
|                     |   "v" INT NULL,                                           |
|                     |   TIME INDEX ("ts"),                                      |
|                     |   PRIMARY KEY ("tenant_id", "device_id", "host")          |
|                     | )                                                         |
|                     | PARTITION ON COLUMNS ("tenant_id", "device_id", "host") ( |
|                     |   hash("tenant_id", "device_id", "host") < '8',           |
|                     |   hash("tenant_id", "device_id", "host") >= '8'           |
|                     | )                                                         |
|                     | ENGINE=mito                                               |
|                     |                                                           |
+---------------------+-----------------------------------------------------------+

SELECT * FROM integer_hash_routes ORDER BY ts;

+----------------------+----------------------+------+-------------------------+---+
| tenant_id            | device_id            | host | ts                      | v |
+----------------------+----------------------+------+-------------------------+---+
| 42                   | 42                   | a    | 1970-01-01T00:00:00.001 | 1 |
| -1                   | 18446744073709551615 | b    | 1970-01-01T00:00:00.002 | 2 |
| -9223372036854775808 | 0                    | 中   | 1970-01-01T00:00:00.003 | 3 |
|                      | 42                   | a    | 1970-01-01T00:00:00.004 | 4 |
| 42                   |                      | a    | 1970-01-01T00:00:00.005 | 5 |
| 42                   | 42                   |      | 1970-01-01T00:00:00.006 | 6 |
+----------------------+----------------------+------+-------------------------+---+

INSERT INTO integer_hash_routes VALUES (42, 42, 'a', 1, 10), (-1, 18446744073709551615, 'b', 2, 20), (-9223372036854775808, 0, '中', 3, 30), (NULL, 42, 'a', 4, 40), (42, NULL, 'a', 5, 50), (42, 42, NULL, 6, 60);

Affected Rows: 6

