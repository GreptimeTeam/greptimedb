SHOW CREATE TABLE function_routes;

+-----------------+------------------------------------------------+
| Table           | Create Table                                   |
+-----------------+------------------------------------------------+
| function_routes | CREATE TABLE IF NOT EXISTS "function_routes" ( |
|                 |   "host" STRING NULL,                          |
|                 |   "ts" TIMESTAMP(3) NOT NULL,                  |
|                 |   "v" INT NULL,                                |
|                 |   TIME INDEX ("ts"),                           |
|                 |   PRIMARY KEY ("host")                         |
|                 | )                                              |
|                 | PARTITION ON COLUMNS ("host") (                |
|                 |   hash(substring("host", 1, 2)) < '8',         |
|                 |   hash(substring("host", 1, 2)) >= '8'         |
|                 | )                                              |
|                 | ENGINE=mito                                    |
|                 |                                                |
+-----------------+------------------------------------------------+

SELECT * FROM function_routes ORDER BY ts;

+------+-------------------------+---+
| host | ts                      | v |
+------+-------------------------+---+
| abc  | 1970-01-01T00:00:00.001 | 1 |
| xyz  | 1970-01-01T00:00:00.002 | 2 |
| 中🙂 | 1970-01-01T00:00:00.003 | 3 |
|      | 1970-01-01T00:00:00.004 | 4 |
+------+-------------------------+---+

INSERT INTO function_routes VALUES ('abc', 1, 10), ('xyz', 2, 20), ('中🙂', 3, 30), (NULL, 4, 40);

Affected Rows: 4

