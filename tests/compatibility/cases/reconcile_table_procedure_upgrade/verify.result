-- SQLNESS SLEEP 10s
SELECT COUNT(*) = 1 AS recovered
FROM greptime_private.events
WHERE type = 'reconcile_table'
  AND schema_name = 'reconcile_table_procedure_upgrade'
  AND table_name = 'reconcile_upgrade_target'
  AND json_get_string(procedure_trigger, 'type') = 'Recovered';

+-----------+
| recovered |
+-----------+
| true      |
+-----------+

SELECT COUNT(*) = 1 AS legacy_summary_preserved
FROM greptime_private.events
WHERE type = 'reconcile_table'
  AND schema_name = 'reconcile_table_procedure_upgrade'
  AND table_name = 'reconcile_upgrade_target'
  AND json_get_string(procedure_trigger, 'type') = 'Succeeded'
  AND json_get_int(payload, 'version') = 1
  AND json_get_bool(payload, 'complete') = true
  AND json_get_string(payload, 'metadata_state') IS NULL
  AND json_get_string(payload, 'resolution_strategy_applied') IS NULL
  AND json_get_int(payload, 'resolved_column_count') IS NULL
  AND json_get_int(payload, 'scanned_region_count') = 0
  AND json_get_int(payload, 'updated_region_count') = 0
  AND json_get_bool(payload, 'table_info_updated') = false
  AND json_get_string(payload, 'last_completed_phase') IS NULL;

+--------------------------+
| legacy_summary_preserved |
+--------------------------+
| true                     |
+--------------------------+

SELECT COUNT(*) AS target_rows
FROM reconcile_upgrade_target;

+-------------+
| target_rows |
+-------------+
| 2           |
+-------------+
