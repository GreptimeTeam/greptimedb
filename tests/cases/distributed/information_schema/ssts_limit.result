|               | ]]                                                                                                                                                                                                                                                                           |
| physical_plan | SortPreservingMergeExec: [min_ts@0 DESC], fetch=1                                                                                                                                                                                                                            |
|               |   CooperativeExec                                                                                                                                                                                                                                                            |
|               |     RepartitionExec: REDACTED
|               |       SortExec: TopK(fetch=1), expr=[min_ts@0 DESC], preserve_partitioning=[false]                                                                                                                                                                                           |
|               |         DistributedInspectExec: kind=SstManifest, scan=ScanRequest { projection: [16], filters: [region_id > UInt64(0)] }, schema=Schema { fields: [Field { name: "min_ts", data_type: Timestamp(Nanosecond, None), nullable: true }], metadata: {"greptime:version": "0"} } |
|               |                                                                                                                                                                                                                                                                              |
+---------------+------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+

-- Timestamp filtering happens before global ordering and offset. The sort key
-- must remain available even when it is absent from the output projection.
SELECT max_ts
FROM information_schema.ssts_manifest
WHERE region_id > 0 AND min_ts >= '1970-01-01T00:00:00.002Z'::TIMESTAMP_NS
ORDER BY min_ts DESC
LIMIT 1 OFFSET 1;

+-------------------------+
| max_ts                  |
+-------------------------+
| 1970-01-01T00:00:00.002 |
+-------------------------+

