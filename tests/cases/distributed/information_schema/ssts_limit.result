-- The frontend orders results from all datanodes before applying the global offset.
SELECT min_ts, max_ts
FROM information_schema.ssts_manifest
WHERE region_id > 0
ORDER BY min_ts DESC
LIMIT 2 OFFSET 1;

+-------------------------+-------------------------+
| min_ts                  | max_ts                  |
+-------------------------+-------------------------+
| 1970-01-01T00:00:00.002 | 1970-01-01T00:00:00.002 |
| 1970-01-01T00:00:00.001 | 1970-01-01T00:00:00.001 |
+-------------------------+-------------------------+

