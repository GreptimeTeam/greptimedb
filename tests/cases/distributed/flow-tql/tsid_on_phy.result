CREATE FLOW IF NOT EXISTS test_tsid
SINK TO 'test_tsid_output'
EVAL INTERVAL '3600 s'
AS
TQL EVAL (
  timestamp '2026-01-23 03:10:00+00' + (now() - now()),
  timestamp '2026-01-23 03:50:00+00' + (now() - now()),
  '1m'
)
histogram_quantile(
  0.50,
  sum by (le, tag4, tag5) (
    avg_over_time(test_tsid[30m])
  )
);

Affected Rows: 0

