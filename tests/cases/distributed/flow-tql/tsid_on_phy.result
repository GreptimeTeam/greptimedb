-- Simplified schema and queries for TSID on physical table
CREATE TABLE phy (
  ts TIMESTAMP(3) TIME INDEX,
  v DOUBLE NULL,
  tag1 STRING,
  tag2 STRING,
  le STRING,
  tag4 STRING,
  tag5 STRING,
  tag6 STRING NULL,
  tag7 STRING NULL,
  tag8 STRING NULL,
  PRIMARY KEY (
    tag1,
    tag2,
    le,
    tag4,
    tag5,
    tag6,
    tag7,
    tag8
  )
) ENGINE = metric WITH ("physical_metric_table" = "");

Affected Rows: 0

CREATE TABLE IF NOT EXISTS test_tsid (
  tag1 STRING,
  tag2 STRING,
  ts TIMESTAMP(3) NOT NULL,
  v DOUBLE NULL,
  le STRING,
  tag4 STRING,
  tag5 STRING,
  tag6 STRING NULL,
  tag7 STRING NULL,
  tag8 STRING NULL,
  TIME INDEX (ts),
  PRIMARY KEY (
    tag1,
    tag2,
    le,
    tag4,
    tag5,
    tag6,
    tag7,
    tag8
  )
) ENGINE=metric WITH(
  on_physical_table = 'phy'
);

Affected Rows: 0

