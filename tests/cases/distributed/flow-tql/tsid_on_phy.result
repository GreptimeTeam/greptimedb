-- SQLNESS SORT_RESULT 3 1
TQL EVAL (
  timestamp '2026-01-23 03:30:00+00' + (now() - now()),
  timestamp '2026-01-23 03:45:00+00' + (now() - now()),
  '1m'
) histogram_quantile(
  0.50,
  sum by (le, tag4, tag5) (
    avg_over_time(test_tsid[30m])
  )
);

