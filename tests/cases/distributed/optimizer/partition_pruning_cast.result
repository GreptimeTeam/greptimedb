CREATE TABLE partition_pruning_cast_partitioned (
    ts TIMESTAMP TIME INDEX,
    k FLOAT PRIMARY KEY,
    v BIGINT,
)
PARTITION ON COLUMNS (k) (
    k < 1.25,
    k >= 1.25
);

Affected Rows: 0

CREATE TABLE partition_pruning_cast_control (
    ts TIMESTAMP TIME INDEX,
    k FLOAT PRIMARY KEY,
    v BIGINT,
);

Affected Rows: 0

INSERT INTO partition_pruning_cast_partitioned VALUES
