| Table            | Create Table                                    |
+------------------+-------------------------------------------------+
| prefix_partition | CREATE TABLE IF NOT EXISTS "prefix_partition" ( |
|                  |   "host" STRING NULL,                           |
|                  |   "ts" TIMESTAMP(3) NOT NULL,                   |
|                  |   "v" INT NULL,                                 |
|                  |   TIME INDEX ("ts"),                            |
|                  |   PRIMARY KEY ("host")                          |
|                  | )                                               |
|                  | PARTITION ON COLUMNS ("host") (                 |
|                  |   substring("host", 1, 1) < 'm',                |
|                  |   substring("host", 1, 1) >= 'm'                |
|                  | )                                               |
|                  | ENGINE=mito                                     |
|                  |                                                 |
+------------------+-------------------------------------------------+

