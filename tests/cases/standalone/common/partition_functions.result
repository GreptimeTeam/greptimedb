CREATE TABLE prefix_partition (host STRING PRIMARY KEY, ts TIMESTAMP TIME INDEX, v INT)
PARTITION ON COLUMNS (host) (
  substring(host, 1, 1) < 'm',
  substring(host, 1, 1) >= 'm'
);

Affected Rows: 0

SHOW CREATE TABLE prefix_partition;

