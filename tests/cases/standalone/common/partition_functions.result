CREATE TABLE dynamic_substring (host STRING, length BIGINT, ts TIMESTAMP TIME INDEX, PRIMARY KEY(host, length))
PARTITION ON COLUMNS (host, length) (
  substring(host, 1, length) < NULL OR substring(host, 1, length) >= NULL
);

