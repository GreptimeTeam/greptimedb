CREATE TABLE hash_partition (host STRING, idc STRING, ts TIMESTAMP TIME INDEX, v INT, PRIMARY KEY(host, idc))
PARTITION ON COLUMNS (host, idc) (
  hash(host, idc) < '8',
  hash(host, idc) >= '8'
);

Affected Rows: 0

