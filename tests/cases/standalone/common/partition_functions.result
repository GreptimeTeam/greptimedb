CREATE TABLE guarded_substring (host STRING, length BIGINT, ts TIMESTAMP TIME INDEX, PRIMARY KEY(host, length))
PARTITION ON COLUMNS (host, length) (
  host < 'm' AND substring(host, 1, length) < 'm',
  host < 'm' AND substring(host, 1, length) >= 'm',
  host >= 'm'
);

