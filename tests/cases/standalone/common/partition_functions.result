CREATE TABLE nested_partition (host STRING PRIMARY KEY, ts TIMESTAMP TIME INDEX)
PARTITION ON COLUMNS (host) (
  substring(hash(substring(host, 1)), 1, 1) < '8',
  substring(hash(substring(host, 1)), 1, 1) >= '8'
);

