CREATE TABLE create_col_options (
    ts TIMESTAMP TIME INDEX,
    host STRING,
    az STRING COMMENT 'availability zone',
    body STRING NOT NULL DEFAULT '' COMMENT 'log body',
    prompt STRING,
    PRIMARY KEY (host, az),
);

Affected Rows: 0

SHOW CREATE TABLE create_col_options;

+--------------------+---------------------------------------------------------+
| Table              | Create Table                                            |
+--------------------+---------------------------------------------------------+
| create_col_options | CREATE TABLE IF NOT EXISTS "create_col_options" (       |
|                    |   "ts" TIMESTAMP(3) NOT NULL,                           |
|                    |   "host" STRING NULL,                                   |
|                    |   "az" STRING NULL COMMENT 'availability zone',         |
|                    |   "body" STRING NOT NULL DEFAULT '' COMMENT 'log body', |
|                    |   "prompt" STRING NULL,                                 |
|                    |   TIME INDEX ("ts"),                                    |
|                    |   PRIMARY KEY ("host", "az")                            |
|                    | )                                                       |
|                    |                                                         |
|                    | ENGINE=mito                                             |
|                    |                                                         |
+--------------------+---------------------------------------------------------+

