-- Invalid options are rejected and leave the column options untouched.
ALTER TABLE alter_compression MODIFY COLUMN payload COMPRESSION WITH (level = '0');

Error: 1004(InvalidArguments), Invalid alter table(alter_compression) request: Invalid compression option: invalid level: 0, expected: an integer in 1..=22

ALTER TABLE alter_compression MODIFY COLUMN payload COMPRESSION WITH (level = '23');

Error: 1004(InvalidArguments), Invalid alter table(alter_compression) request: Invalid compression option: invalid level: 23, expected: an integer in 1..=22

ALTER TABLE alter_compression MODIFY COLUMN payload COMPRESSION WITH (type = 'lz4');

Error: 1004(InvalidArguments), Invalid alter table(alter_compression) request: Invalid compression option: invalid type: lz4, expected: 'zstd'

ALTER TABLE alter_compression MODIFY COLUMN payload COMPRESSION WITH (page_size = 'large');

Error: 1004(InvalidArguments), Invalid alter table(alter_compression) request: Invalid compression option: invalid page_size: large, expected: a positive size such as '8MiB'

ALTER TABLE alter_compression MODIFY COLUMN payload COMPRESSION WITH (page_size = '0');

Error: 1004(InvalidArguments), Invalid alter table(alter_compression) request: Invalid compression option: invalid page_size: 0, expected: a positive size such as '8MiB'

ALTER TABLE alter_compression MODIFY COLUMN payload COMPRESSION WITH (codec = 'zstd');

Error: 1004(InvalidArguments), Invalid column option, column name: payload, error: invalid COMPRESSION option: codec

ALTER TABLE alter_compression MODIFY COLUMN payload COMPRESSION WITH ();

Error: 1004(InvalidArguments), Invalid column option, column name: payload, error: expect WITH (...) after COMPRESSION keyword

ALTER TABLE alter_compression MODIFY COLUMN missing COMPRESSION WITH (level = '3');

Error: 4002(TableColumnNotFound), Column missing not exists in table alter_compression

-- Nested columns are rejected: their values live in child columns.
ALTER TABLE alter_compression MODIFY COLUMN j COMPRESSION WITH (level = '3');

Error: 1004(InvalidArguments), Invalid alter table(alter_compression) request: Invalid compression option: compression options are not supported on column j of type Json2"<Null>"

-- ADD COLUMN has no compression support.
ALTER TABLE alter_compression ADD COLUMN extra STRING COMPRESSION WITH (level = '3');

Error: 1004(InvalidArguments), Invalid column option, column name: extra, error: ADD COLUMN does not support COMPRESSION

