| Table                  | Create Table                                          |
+------------------------+-------------------------------------------------------+
| alter_compression_tags | CREATE TABLE IF NOT EXISTS "alter_compression_tags" ( |
|                        |   "ts" TIMESTAMP(3) NOT NULL,                         |
|                        |   "host" STRING NULL,                                 |
|                        |   "val" DOUBLE NULL,                                  |
|                        |   TIME INDEX ("ts"),                                  |
|                        |   PRIMARY KEY ("host")                                |
|                        | )                                                     |
|                        |                                                       |
|                        | ENGINE=mito                                           |
|                        | WITH(                                                 |
|                        |   sst_format = 'primary_key'                          |
|                        | )                                                     |
+------------------------+-------------------------------------------------------+

CREATE TABLE alter_compression_tags_dense (
    ts TIMESTAMP TIME INDEX,
    host STRING PRIMARY KEY,
    val DOUBLE
) WITH ('sst_format' = 'flat', 'primary_key_encoding' = 'dense');

