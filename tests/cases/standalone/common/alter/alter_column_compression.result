-- Compression is a physical-table concern for the metric engine.
CREATE TABLE alter_compression_phy (
    ts TIMESTAMP TIME INDEX,
    val DOUBLE COMPRESSION WITH (level = '3')
) ENGINE = metric WITH (physical_metric_table = '');

Affected Rows: 0

