CREATE TABLE json2_query_respect_type_hint (
    ts TIMESTAMP TIME INDEX,
    j JSON2 (
        a BIGINT,
        b STRING
    ),
    exponent DOUBLE
) WITH (
    'append_mode' = 'true'
);

