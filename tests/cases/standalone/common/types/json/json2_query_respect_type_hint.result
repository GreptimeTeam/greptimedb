-- Uncast paths use their JSON2 type hints.
SELECT
    j.a AS hinted_bigint,
    json_get(j, 'a') AS direct_bigint,
    json_get(j, '$.a') AS rooted_bigint,
    j.b AS hinted_string,
    json_get(j, 'b') AS direct_string
FROM json2_query_respect_type_hint
ORDER BY ts;

+------------------+------------------+------------------+---------------+---------------+
| hinted_bigint    | direct_bigint    | rooted_bigint    | hinted_string | direct_string |
+------------------+------------------+------------------+---------------+---------------+
| 9007199254740993 | 9007199254740993 | 9007199254740993 | three         | three         |
| 7                | 7                | 7                | 7             | 7             |
|                  |                  |                  |               |               |
|                  |                  |                  |               |               |
+------------------+------------------+------------------+---------------+---------------+

-- The SST read keeps the same result types as the memtable read.
SELECT arrow_typeof(j.a) AS dotted_type, arrow_typeof(json_get(j, 'a')) AS direct_type,
       arrow_typeof(j.b) AS dotted_string_type, arrow_typeof(json_get(j, 'b')) AS direct_string_type
FROM json2_query_respect_type_hint LIMIT 1;

+-------------+-------------+--------------------+--------------------+
| dotted_type | direct_type | dotted_string_type | direct_string_type |
+-------------+-------------+--------------------+--------------------+
| Int64       | Int64       | Utf8View           | Utf8View           |
+-------------+-------------+--------------------+--------------------+

-- A JSON2 type hint takes precedence over an explicit SQL cast for the native
-- read type.
-- SQLNESS REPLACE (peers.*) REDACTED
EXPLAIN SELECT j.a::STRING, json_get(j, 'a')::STRING
FROM json2_query_respect_type_hint;

+---------------+--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| plan_type     | plan                                                                                                                                                                           |
+---------------+--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| logical_plan  | MergeScan [is_placeholder=false, remote_input=[                                                                                                                                |
|               | Projection: CAST(json_get(json2_query_respect_type_hint.j, Utf8("$.a"), Int64(NULL)) AS Utf8), CAST(json_get(json2_query_respect_type_hint.j, Utf8("a"), Int64(NULL)) AS Utf8) |
|               |   TableScan: json2_query_respect_type_hint                                                                                                                                     |
|               | ]]                                                                                                                                                                             |
| physical_plan | CooperativeExec                                                                                                                                                                |
|               |   MergeScanExec: REDACTED
|               |                                                                                                                                                                                |
+---------------+--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+

-- An explicit CAST changes the expression result type.
SELECT
    j.a::STRING AS cast_string,
    json_get(j, 'a')::STRING AS direct_cast_string,
    arrow_typeof(json_get(j, 'a')::STRING) AS cast_type
FROM json2_query_respect_type_hint
ORDER BY ts;

+------------------+--------------------+-----------+
| cast_string      | direct_cast_string | cast_type |
+------------------+--------------------+-----------+
| 9007199254740993 | 9007199254740993   | Utf8      |
| 7                | 7                  | Utf8      |
|                  |                    | Utf8      |
|                  |                    | Utf8      |
+------------------+--------------------+-----------+

-- A JSON2 type hint takes precedence over expression-context inference.
-- SQLNESS REPLACE (peers.*) REDACTED
EXPLAIN SELECT coalesce(j.b, exponent), coalesce(json_get(j, 'b'), exponent)
FROM json2_query_respect_type_hint;

+---------------+--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| plan_type     | plan                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                           |
+---------------+--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| logical_plan  | MergeScan [is_placeholder=false, remote_input=[                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                |
|               | Projection: CASE WHEN CAST(json_get(json2_query_respect_type_hint.j, Utf8("$.b"), Utf8View(NULL)) AS Float64) IS NOT NULL THEN CAST(json_get(json2_query_respect_type_hint.j, Utf8("$.b"), Utf8View(NULL)) AS Float64) ELSE json2_query_respect_type_hint.exponent END AS coalesce(json_get(json2_query_respect_type_hint.j,Utf8("$.b"),Utf8View(NULL)),json2_query_respect_type_hint.exponent), CASE WHEN CAST(json_get(json2_query_respect_type_hint.j, Utf8("b"), Utf8View(NULL)) AS Float64) IS NOT NULL THEN CAST(json_get(json2_query_respect_type_hint.j, Utf8("b"), Utf8View(NULL)) AS Float64) ELSE json2_query_respect_type_hint.exponent END AS coalesce(json_get(json2_query_respect_type_hint.j,Utf8("b"),Utf8View(NULL)),json2_query_respect_type_hint.exponent) |
|               |   TableScan: json2_query_respect_type_hint                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                     |
|               | ]]                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             |
| physical_plan | CooperativeExec                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                |
|               |   MergeScanExec: REDACTED
|               |                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                |
