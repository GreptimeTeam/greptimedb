SELECT ts,
       j.o.l[1].CASEKEY AS normalized,
       j.o.l[1]."UPPER" AS quoted_upper,
       j.o.l[1]."a.b" AS dotted_key
FROM json2_list_index
ORDER BY ts;

+-------------------------+------------+--------------+------------+
| ts                      | normalized | quoted_upper | dotted_key |
