CREATE TABLE json2_type_hint_read_type (
    ts TIMESTAMP TIME INDEX,
    j JSON2 (
        a BIGINT,
        b STRING
    ),
    exponent DOUBLE
) WITH (
    'append_mode' = 'true'
);

Affected Rows: 0

