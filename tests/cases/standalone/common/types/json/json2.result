Affected Rows: 0

-- A JSON null in a dynamically typed field must remain SQL NULL when the
-- field is projected to the default string type, rather than becoming "null".
create table json2_variant_null (
    ts timestamp time index,
    j json2
) with (
    'append_mode' = 'true',
    'sst_format' = 'flat'
);

Affected Rows: 0

insert into json2_variant_null values
    (1, '{"payload":{"value":1}}'),
    (2, '{"payload":"text"}'),
    (3, '{"payload":null}');

Affected Rows: 3

select ts, j.payload, j.payload is null as payload_is_null
from json2_variant_null
order by ts;

+-------------------------+------------------------------------------------+-----------------+
| ts                      | json_get(json2_variant_null.j,Utf8("payload")) | payload_is_null |
+-------------------------+------------------------------------------------+-----------------+
| 1970-01-01T00:00:00.001 | {"value":1}                                    | false           |
| 1970-01-01T00:00:00.002 | text                                           | false           |
| 1970-01-01T00:00:00.003 |                                                | true            |
+-------------------------+------------------------------------------------+-----------------+

