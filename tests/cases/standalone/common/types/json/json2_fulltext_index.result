| Table                | Create Table                                                                                                                                                                                                                                                                     |
+----------------------+----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| json2_fulltext_bloom | CREATE TABLE IF NOT EXISTS "json2_fulltext_bloom" (                                                                                                                                                                                                                              |
|                      |   "ts" TIMESTAMP(3) NOT NULL,                                                                                                                                                                                                                                                    |
|                      |   "attrs" JSON2(                                                                                                                                                                                                                                                                 |
|                      |     max_auto_expanded_paths = 0,                                                                                                                                                                                                                                                 |
|                      |     "nested"."message" STRING SKIPPING INDEX WITH (granularity = '10240', false_positive_rate = '0.01', type = 'BLOOM') FULLTEXT INDEX WITH (analyzer = 'English', case_sensitive = 'false', backend = 'bloom', granularity = '1', false_positive_rate = '0.01') INVERTED INDEX, |
|                      |     "nested.message" STRING FULLTEXT INDEX WITH (analyzer = 'English', case_sensitive = 'false', backend = 'bloom', granularity = '1', false_positive_rate = '0.01')                                                                                                             |
|                      |   ) NULL,                                                                                                                                                                                                                                                                        |
|                      |   "ordinary" STRING NULL FULLTEXT INDEX WITH(analyzer = 'English', backend = 'bloom', case_sensitive = 'false', false_positive_rate = '0.01', granularity = '1'),                                                                                                                |
|                      |   TIME INDEX ("ts")                                                                                                                                                                                                                                                              |
|                      | )                                                                                                                                                                                                                                                                                |
|                      |                                                                                                                                                                                                                                                                                  |
|                      | ENGINE=mito                                                                                                                                                                                                                                                                      |
|                      | WITH(                                                                                                                                                                                                                                                                            |
|                      |   append_mode = 'true',                                                                                                                                                                                                                                                          |
|                      |   sst_format = 'flat'                                                                                                                                                                                                                                                            |
|                      | )                                                                                                                                                                                                                                                                                |
