-- Explicit SQL NULL and omitted-column inserts must be accepted and round trip
-- as NULL (not panic), remaining distinct from empty objects.
create table json_empty_null_forms (
    ts timestamp time index,
    j json2
) with (
    'append_mode' = 'true',
    'sst_format' = 'flat'
);

