-- A predicate on an added JSON2 field must retain older values of other fields.
CREATE TABLE json2_alter_backfill (
    host STRING,
    ts TIMESTAMP TIME INDEX,
    f DOUBLE,
    PRIMARY KEY (host)
) WITH ('merge_mode' = 'last_non_null');

