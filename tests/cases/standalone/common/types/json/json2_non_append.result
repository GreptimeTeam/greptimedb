-- JSON2 is merged as a whole field, including empty objects and explicit JSON nulls.
CREATE TABLE json2_last_non_null (
    host STRING,
    ts TIMESTAMP TIME INDEX,
    j JSON2,
    k JSON2(max_auto_expanded_paths = 0),
    f DOUBLE,
    PRIMARY KEY (host)
) WITH (
    'append_mode' = 'false',
    'merge_mode' = 'last_non_null'
);

