-- Arrow casts Boolean values to Float64 as true = 1.0 and false = 0.0.
select abs(j.metrics.value) as abs_value from json2_function_table order by ts;

+-----------+
| abs_value |
+-----------+
| 1.0       |
| 2.5       |
|           |
| 1.0       |
|           |
|           |
|           |
|           |
|           |
| 10.0      |
+-----------+

