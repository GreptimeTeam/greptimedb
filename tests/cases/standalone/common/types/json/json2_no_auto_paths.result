| 1970-01-01T00:00:00.002 | {"groups":[{"members":[]},{"members":[{"name":"b1"}]}],"matrix":[[10],[20,21]],"profile":{"contact":{"address":{"city":"Berlin"}},"name":"bob"}}                            |
| 1970-01-01T00:00:00.003 | {}                                                                                                                                                                          |
| 1970-01-01T00:00:00.004 | {"groups":[null,{"members":[null,{"name":"c1"}]}],"matrix":[[],[30]],"profile":{"contact":{"address":{}},"name":"carol"}}                                                   |
