-- Query options are session-scoped; request hints take precedence per query.
-- SQLNESS PROTOCOL MYSQL
SET query_parallelism = 8;

affected_rows: 0

-- SQLNESS PROTOCOL MYSQL
SHOW VARIABLES query.parallelism;

+-------------------+
| query.parallelism |
+-------------------+
| 8                 |
+-------------------+

