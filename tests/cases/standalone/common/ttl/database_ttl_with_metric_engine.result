CREATE DATABASE test_ttl_db WITH (ttl = '1 second');

Affected Rows: 1

USE test_ttl_db;

Affected Rows: 0

CREATE TABLE phy (ts timestamp time index, val double) engine=metric with ("physical_metric_table" = "");

Affected Rows: 0

-- It will use the database TTL setting --
CREATE TABLE test_ttl (ts timestamp time index, val double, host string primary key) engine = metric with ("on_physical_table" = "phy");

Affected Rows: 0

-- Logical tables omit database TTL in SHOW CREATE TABLE
SHOW CREATE TABLE test_ttl;

+----------+-----------------------------------------+
| Table    | Create Table                            |
+----------+-----------------------------------------+
| test_ttl | CREATE TABLE IF NOT EXISTS "test_ttl" ( |
|          |   "host" STRING NULL,                   |
|          |   "ts" TIMESTAMP(3) NOT NULL,           |
|          |   "val" DOUBLE NULL,                    |
|          |   TIME INDEX ("ts"),                    |
|          |   PRIMARY KEY ("host")                  |
|          | )                                       |
|          |                                         |
|          | ENGINE=metric                           |
|          | WITH(                                   |
|          |   on_physical_table = 'phy'             |
|          | )                                       |
+----------+-----------------------------------------+

-- Legacy logical DDL with retention TTL succeeds with the retention option stripped
CREATE TABLE legacy_ttl (ts timestamp time index, val double) engine=metric with ("on_physical_table" = "phy", "ttl" = "7d");

Affected Rows: 0

SELECT table_name, create_options FROM information_schema.tables WHERE table_schema = 'test_ttl_db' AND table_name = 'legacy_ttl';

+------------+-----------------------+
| table_name | create_options        |
+------------+-----------------------+
| legacy_ttl | on_physical_table=phy |
+------------+-----------------------+

-- Instant TTL is preserved on logical tables
CREATE TABLE instant_ttl (ts timestamp time index, val double) engine=metric with ("on_physical_table" = "phy", "ttl" = "instant");

Affected Rows: 0

SHOW CREATE TABLE instant_ttl;

+-------------+--------------------------------------------+
| Table       | Create Table                               |
+-------------+--------------------------------------------+
| instant_ttl | CREATE TABLE IF NOT EXISTS "instant_ttl" ( |
|             |   "ts" TIMESTAMP(3) NOT NULL,              |
|             |   "val" DOUBLE NULL,                       |
|             |   TIME INDEX ("ts")                        |
|             | )                                          |
|             |                                            |
|             | ENGINE=metric                              |
|             | WITH(                                      |
|             |   on_physical_table = 'phy',               |
|             |   ttl = 'instant'                          |
|             | )                                          |
+-------------+--------------------------------------------+

SELECT table_name, create_options FROM information_schema.tables WHERE table_schema = 'test_ttl_db' AND table_name = 'instant_ttl';

+-------------+-----------------------------------+
| table_name  | create_options                    |
+-------------+-----------------------------------+
| instant_ttl | ttl=instant on_physical_table=phy |
+-------------+-----------------------------------+

DROP TABLE legacy_ttl;

Affected Rows: 0

DROP TABLE instant_ttl;

Affected Rows: 0

INSERT INTO test_ttl(ts, val, host) VALUES
       (now(), 1, 'host1'),
       (now(), 2, 'host2'),
       (now(), 3, 'host3');

Affected Rows: 3

SELECT val, host FROM test_ttl ORDER BY host;

+-----+-------+
| val | host  |
+-----+-------+
| 1.0 | host1 |
| 2.0 | host2 |
| 3.0 | host3 |
+-----+-------+

-- SQLNESS SLEEP 2s
ADMIN flush_table('phy');

+--------------------------+
| ADMIN flush_table('phy') |
+--------------------------+
| 0                        |
+--------------------------+

ADMIN compact_table('phy');

+----------------------------+
| ADMIN compact_table('phy') |
+----------------------------+
| 0                          |
+----------------------------+

--- should be expired --
SELECT val, host FROM test_ttl;

+-----+------+
| val | host |
+-----+------+
+-----+------+

ALTER DATABASE test_ttl_db SET ttl = '1 day';

Affected Rows: 0

INSERT INTO test_ttl(ts, val, host) VALUES
       (now(), 1, 'host1'),
       (now(), 2, 'host2'),
       (now(), 3, 'host3');

Affected Rows: 3

ADMIN flush_table('phy');

+--------------------------+
| ADMIN flush_table('phy') |
+--------------------------+
| 0                        |
+--------------------------+

ADMIN compact_table('phy');

+----------------------------+
| ADMIN compact_table('phy') |
+----------------------------+
| 0                          |
+----------------------------+

--- should not be expired --
SELECT val, host FROM test_ttl ORDER BY host;

+-----+-------+
| val | host  |
+-----+-------+
| 1.0 | host1 |
| 2.0 | host2 |
| 3.0 | host3 |
+-----+-------+

-- restart the db, ensure everything is ok
-- SQLNESS ARG restart=true
SELECT val, host FROM test_ttl ORDER BY host;

+-----+-------+
| val | host  |
+-----+-------+
| 1.0 | host1 |
| 2.0 | host2 |
| 3.0 | host3 |
+-----+-------+

