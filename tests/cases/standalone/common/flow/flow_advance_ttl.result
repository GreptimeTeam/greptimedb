|                |   "number" INT NULL,                                      |
|                |   "ts" TIMESTAMP(3) NOT NULL DEFAULT current_timestamp(), |
|                |   TIME INDEX ("ts"),                                      |
|                |   PRIMARY KEY ("number")                                  |
|                | )                                                         |
|                |                                                           |
|                | ENGINE=mito                                               |
|                | WITH(                                                     |
