|_|_Filter: sum(CASE WHEN having_input_bounds.service_name = Utf8("cart") AND having_input_bounds.span_name = Utf8("GetCart") AND having_input_bounds.ts >= Int64(10) AND having_input_bounds.ts < Int64(20) THEN Int64(1) ELSE Int64(0) END) > Int64(0)_|
|_|_Aggregate: groupBy=[[having_input_bounds.trace_id]], aggr=[[__min_merge(__min_state(having_input_bounds.ts)) AS min(having_input_bounds.ts), __sum_merge(__sum_state(CASE WHEN having_input_bounds.service_name = Utf8("cart") AND having_input_bounds.span_name = Utf8("GetCart") AND having_input_bounds.ts >= Int64(10) AND having_input_bounds.ts < Int64(20) THEN Int64(1) ELSE Int64(0) END)) AS sum(CASE WHEN having_input_bounds.service_name = Utf8("cart") AND having_input_bounds.span_name = Utf8("GetCart") AND having_input_bounds.ts >= Int64(10) AND having_input_bounds.ts < Int64(20) THEN Int64(1) ELSE Int64(0) END)]]_|
