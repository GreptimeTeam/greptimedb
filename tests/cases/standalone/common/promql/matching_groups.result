-- PromQL groups both representations under the same empty label.
-- SQLNESS SORT_RESULT 3 1
TQL EVAL (0, 0, '1s') max by(host)(matching_groups_right);

+------+---------------------+-------------------------------------------+
| host | ts                  | max(matching_groups_right.greptime_value) |
