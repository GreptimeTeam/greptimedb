CREATE TABLE matching_groups_left (
  host STRING NULL,
  "zone" STRING NULL,
  ts TIMESTAMP(3) TIME INDEX,
  greptime_value DOUBLE,
  PRIMARY KEY(host, "zone")
);

Affected Rows: 0

CREATE TABLE matching_groups_right (
  host STRING NULL,
  "zone" STRING NULL,
  ts TIMESTAMP(3) TIME INDEX,
  greptime_value DOUBLE,
  PRIMARY KEY(host, "zone")
);

