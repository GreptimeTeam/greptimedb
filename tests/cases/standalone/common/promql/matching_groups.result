|      | 1970-01-01T00:00:00 | 10.0                                      |
| x    | 1970-01-01T00:00:00 | 4.0                                       |
| y    | 1970-01-01T00:00:00 | 100.0                                     |
+------+---------------------+-------------------------------------------+

-- SQLNESS SORT_RESULT 3 1
TQL EVAL (0, 0, '1s') sum without(zone)(matching_groups_right);

+------+---------------------+-------------------------------------------+
| host | ts                  | sum(matching_groups_right.greptime_value) |
