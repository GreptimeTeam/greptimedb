| one_ms | 10.0  | 1970-01-01T00:00:00.998       |
| one_ms | 13.0  | 1970-01-01T00:00:00.999       |
| sub_ms | 10.0  | 1970-01-01T00:00:00.999999100 |
| sub_ms | 13.0  | 1970-01-01T00:00:00.999999500 |
| sub_ms | 999.0 | 1970-01-01T00:00:00.999999900 |
+--------+-------+-------------------------------+

TQL EVAL (1, 1, '1s') irate(sub_ms_interval[5s]);

+---------------------+----------------------------+--------+
| ts                  | prom_irate(ts_range,value) | job    |
+---------------------+----------------------------+--------+
| 1970-01-01T00:00:01 | 3000.0                     | one_ms |
+---------------------+----------------------------+--------+

TQL EVAL (1, 1, '1s') idelta(sub_ms_interval[5s]);

+---------------------+-----------------------------+--------+
| ts                  | prom_idelta(ts_range,value) | job    |
+---------------------+-----------------------------+--------+
| 1970-01-01T00:00:01 | 3.0                         | one_ms |
+---------------------+-----------------------------+--------+

ADMIN FLUSH_TABLE('sub_ms_interval');

+--------------------------------------+
| ADMIN FLUSH_TABLE('sub_ms_interval') |
+--------------------------------------+
| 0                                    |
+--------------------------------------+

TQL EVAL (1, 1, '1s') irate(sub_ms_interval[5s]);

+---------------------+----------------------------+--------+
| ts                  | prom_irate(ts_range,value) | job    |
+---------------------+----------------------------+--------+
| 1970-01-01T00:00:01 | 3000.0                     | one_ms |
+---------------------+----------------------------+--------+

TQL EVAL (1, 1, '1s') idelta(sub_ms_interval[5s]);

+---------------------+-----------------------------+--------+
| ts                  | prom_idelta(ts_range,value) | job    |
+---------------------+-----------------------------+--------+
| 1970-01-01T00:00:01 | 3.0                         | one_ms |
+---------------------+-----------------------------+--------+

DROP TABLE sub_ms_interval;

