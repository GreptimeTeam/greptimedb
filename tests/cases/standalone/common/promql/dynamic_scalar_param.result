-- SQLNESS SORT_RESULT 3 1
TQL EVAL (1, 1, '1s') quantile_over_time(scalar(vector(0.5)), dynamic_scalar_input[2s]);

+---------------------+--------------------------------------------------------------+---+
| ts                  | prom_quantile_over_time(ts_range,val,scalar(greptime_value)) | k |
