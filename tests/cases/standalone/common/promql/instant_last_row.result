TQL EVAL (1, 1, '1s') instant_last_micro;

+------+--------+---------------------+
| val  | series | ts                  |
+------+--------+---------------------+
| 42.0 | micro  | 1970-01-01T00:00:01 |
+------+--------+---------------------+

