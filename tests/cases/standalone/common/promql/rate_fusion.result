CREATE TABLE rate_fusion (
    ts TIMESTAMP(3) TIME INDEX,
    val DOUBLE,
    dc STRING,
    instance STRING,
    PRIMARY KEY (dc, instance),
) WITH ('append_mode' = 'true');

