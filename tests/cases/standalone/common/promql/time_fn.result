| 1970-01-01T00:00:00 | 2           |
| 1970-01-01T00:00:05 | 3           |
| 1970-01-01T00:00:10 | 31          |
| 1970-01-01T00:00:15 | 0           |
| 1970-01-01T00:00:20 | 59          |
| 1970-01-01T00:00:25 | 0           |
