| Table | Create Table                                                                                                       |
+-------+--------------------------------------------------------------------------------------------------------------------+
| spans | CREATE TABLE IF NOT EXISTS "spans" (                                                                               |
|       |   "ts" TIMESTAMP(3) NOT NULL,                                                                                      |
|       |   "trace_id" STRING NULL SKIPPING INDEX WITH(false_positive_rate = '0.01', granularity = '10240', type = 'BLOOM'), |
|       |   "prompt" STRING NULL COMPRESSION WITH(level = '3', page_size = '8MiB', type = 'zstd'),                           |
|       |   "reply" STRING NULL COMPRESSION WITH(encoding = 'plain', level = '9', type = 'zstd'),                            |
|       |   "tokens" BIGINT NULL COMPRESSION WITH(encoding = 'delta_binary_packed', page_size = '64KiB', type = 'zstd'),     |
|       |   TIME INDEX ("ts")                                                                                                |
|       | )                                                                                                                  |
|       |                                                                                                                    |
|       | ENGINE=mito                                                                                                        |
|       | WITH(                                                                                                              |
|       |   append_mode = 'true'                                                                                             |
|       | )                                                                                                                  |
