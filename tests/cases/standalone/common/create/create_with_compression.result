CREATE TABLE spans (
    ts TIMESTAMP TIME INDEX,
    trace_id STRING SKIPPING INDEX,
    prompt STRING COMPRESSION WITH (type = 'zstd', level = 3, page_size = '8MiB'),
    reply STRING COMPRESSION WITH (level = 9, encoding = 'plain'),
    tokens BIGINT COMPRESSION WITH (page_size = '64KiB', encoding = 'delta_binary_packed'),
) WITH (append_mode = 'true');

Affected Rows: 0

