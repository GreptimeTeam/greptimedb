    (20.0, '2024-01-01 12:00:00', 'host1'),
    (25.0, '2024-01-01 18:00:00', 'host1'),
    (30.0, '2024-01-02 00:00:00', 'host1'),
    (35.0, '2024-01-02 06:00:00', 'host1'),
    (40.0, '2024-01-02 12:00:00', 'host1'),
    (12.0, '2024-01-01 02:00:00', 'host2'),
