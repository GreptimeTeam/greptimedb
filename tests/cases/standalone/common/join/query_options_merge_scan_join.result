-- Four range regions exercise the complete key set across partial MergeScan results.
-- SQLNESS PROTOCOL MYSQL
SET query.parallelism = 2;

affected_rows: 0

-- SQLNESS PROTOCOL MYSQL
SET query.enable_remote_dynamic_filter_pushdown = true;

affected_rows: 0

