+---------------------------------------------+
| query.enable_remote_dynamic_filter_pushdown |
+---------------------------------------------+
| true                                        |
+---------------------------------------------+

-- The ordered semi-join must return all keys with their first (false) row.
-- SQLNESS PROTOCOL MYSQL
SELECT t.key_id, MIN(t.ts) AS first_ts
FROM query_options_merge_join_data t
WHERE t.key_id IN (
    SELECT s.key_id
    FROM query_options_merge_join_data s
    WHERE s.is_match = true
)
GROUP BY t.key_id
ORDER BY t.key_id;

+--------+---------------------+
| key_id | first_ts            |
+--------+---------------------+
| 1      | 2026-10-09 00:00:00 |
| 11     | 2026-10-09 00:00:00 |
| 21     | 2026-10-09 00:00:00 |
| 31     | 2026-10-09 00:00:00 |
+--------+---------------------+

