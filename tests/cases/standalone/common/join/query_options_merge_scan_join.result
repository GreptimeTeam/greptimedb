-- SQLNESS PROTOCOL MYSQL
CREATE TABLE query_options_merge_join_data (
    ts TIMESTAMP TIME INDEX,
    key_id INT,
    is_match BOOLEAN,
    PRIMARY KEY (key_id)
)
PARTITION ON COLUMNS (key_id) (
    key_id < 10,
    key_id >= 10 AND key_id < 20,
    key_id >= 20 AND key_id < 30,
    key_id >= 30
) ENGINE = mito;

affected_rows: 0

