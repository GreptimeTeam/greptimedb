CREATE TABLE projection_spans (
  trace_id STRING,
  span_id STRING,
  parent_span_id STRING,
  service_name STRING,
  payload STRING,
  ts TIMESTAMP TIME INDEX,
  PRIMARY KEY (service_name)
)
PARTITION ON COLUMNS (service_name) (
  service_name < 'storage', service_name >= 'storage'
)
WITH (append_mode = 'true');

