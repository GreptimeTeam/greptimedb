  ('2026-10-09 00:00:00', 3, false), ('2026-10-09 00:00:01', 3, true),
  ('2026-10-09 00:00:00', 11, false), ('2026-10-09 00:00:01', 11, true),
  ('2026-10-09 00:00:00', 12, false), ('2026-10-09 00:00:01', 12, true),
  ('2026-10-09 00:00:00', 13, false), ('2026-10-09 00:00:01', 13, true),
  ('2026-10-09 00:00:00', 21, false), ('2026-10-09 00:00:01', 21, true),
  ('2026-10-09 00:00:00', 22, false), ('2026-10-09 00:00:01', 22, true),
  ('2026-10-09 00:00:00', 23, false), ('2026-10-09 00:00:01', 23, true),
  ('2026-10-09 00:00:00', 31, false), ('2026-10-09 00:00:01', 31, true),
  ('2026-10-09 00:00:00', 32, false), ('2026-10-09 00:00:01', 32, true),
  ('2026-10-09 00:00:00', 33, false), ('2026-10-09 00:00:01', 33, true);

Affected Rows: 24

-- Check the plan retains the partitioned left-semi join and hash keys (N=4).
-- SQLNESS REPLACE (peers.*) peers=REDACTED
EXPLAIN SELECT key_id, MIN(ts) AS first_ts
FROM merge_semi_data
WHERE key_id IN (
  SELECT key_id FROM merge_semi_data WHERE is_match = true
)
GROUP BY key_id ORDER BY key_id;

+---------------+---------------------------------------------------------------------------------------------------------------------------------------+
| plan_type     | plan                                                                                                                                  |
+---------------+---------------------------------------------------------------------------------------------------------------------------------------+
| logical_plan  | Sort: merge_semi_data.key_id ASC NULLS LAST                                                                                           |
|               |   Projection: merge_semi_data.key_id, min(merge_semi_data.ts) AS first_ts                                                             |
|               |     Aggregate: groupBy=[[merge_semi_data.key_id]], aggr=[[min(merge_semi_data.ts)]]                                                   |
|               |       LeftSemi Join: merge_semi_data.key_id = __correlated_sq_1.key_id                                                                |
|               |         Projection: merge_semi_data.ts, merge_semi_data.key_id                                                                        |
|               |           MergeScan [is_placeholder=false, remote_input=[                                                                             |
|               | Filter: merge_semi_data.key_id IS NOT NULL                                                                                            |
|               |   TableScan: merge_semi_data, partial_filters=[merge_semi_data.key_id IS NOT NULL]                                                    |
|               | ]]                                                                                                                                    |
|               |         MergeScan [is_placeholder=false, remote_input=[                                                                               |
|               | SubqueryAlias: __correlated_sq_1                                                                                                      |
|               |   Projection: merge_semi_data.key_id                                                                                                  |
|               |     Filter: merge_semi_data.is_match AND merge_semi_data.key_id IS NOT NULL                                                           |
|               |       TableScan: merge_semi_data, partial_filters=[merge_semi_data.is_match, merge_semi_data.key_id IS NOT NULL]                      |
|               | ]]                                                                                                                                    |
| physical_plan | SortPreservingMergeExec: [key_id@0 ASC NULLS LAST]                                                                                    |
|               |   ProjectionExec: expr=[key_id@0 as key_id, min(merge_semi_data.ts)@1 as first_ts]                                                    |
|               |     SortExec: expr=[key_id@0 ASC NULLS LAST], preserve_partitioning=[true]                                                            |
|               |       AggregateExec: mode=SinglePartitioned, gby=[key_id@1 as key_id], aggr=[min(merge_semi_data.ts)]                                 |
|               |         HashJoinExec: mode=Partitioned, join_type=LeftSemi, on=[(key_id@1, key_id@0)]                                                 |
|               |           RepartitionExec: partitioning=Hash([key_id@1], 4), input_partitions=4                                                       |
|               |             ProjectionExec: expr=[ts@0 as ts, key_id@1 as key_id]                                                                     |
|               |               MergeScanExec: peers=REDACTED
|               |           RepartitionExec: partitioning=Hash([key_id@0], 4), input_partitions=4                                                       |
|               |             MergeScanExec: peers=REDACTED
|               |                                                                                                                                       |
+---------------+---------------------------------------------------------------------------------------------------------------------------------------+

-- Every key matches and reports its earliest (false-row) timestamp.
SELECT key_id, MIN(ts) AS first_ts
FROM merge_semi_data
WHERE key_id IN (
  SELECT key_id FROM merge_semi_data WHERE is_match = true
)
GROUP BY key_id ORDER BY key_id;

