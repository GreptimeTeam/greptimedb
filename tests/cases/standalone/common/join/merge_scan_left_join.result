| k | n |
+---+---+
| 0 | 3 |
| 1 | 3 |
| 2 | 3 |
| 3 | 3 |
| 4 | 3 |
| 5 | 3 |
| 6 | 3 |
| 7 | 3 |
| 8 | 3 |
| 9 | 3 |
| a | 3 |
| b | 3 |
| c | 3 |
| d | 3 |
| e | 3 |
| f | 3 |
| z |   |
+---+---+

-- Assert partitioned hash join and both hash repartition keys at SQLness N=4.
-- SQLNESS REPLACE (peers.*) peers=REDACTED
EXPLAIN SELECT r.k, c.n
FROM (SELECT k FROM merge_left_data WHERE kind = 'root' AND k >= '1' AND k < '5') r
LEFT JOIN (
  SELECT k, COUNT(*) AS n FROM merge_left_data
  WHERE kind = 'child' AND k < '4' GROUP BY k
) c ON r.k = c.k
ORDER BY r.k;

+---------------+---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| plan_type     | plan                                                                                                                                                                                                                                                                                                                                                                                                                                  |
+---------------+---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+
| logical_plan  | Sort: r.k ASC NULLS LAST                                                                                                                                                                                                                                                                                                                                                                                                              |
|               |   Projection: r.k, c.n                                                                                                                                                                                                                                                                                                                                                                                                                |
|               |     Left Join: r.k = c.k                                                                                                                                                                                                                                                                                                                                                                                                              |
|               |       MergeScan [is_placeholder=false, remote_input=[                                                                                                                                                                                                                                                                                                                                                                                 |
|               | SubqueryAlias: r                                                                                                                                                                                                                                                                                                                                                                                                                      |
|               |   Projection: merge_left_data.k                                                                                                                                                                                                                                                                                                                                                                                                       |
|               |     Filter: merge_left_data.kind = Utf8("root") AND merge_left_data.k >= Utf8("1") AND merge_left_data.k < Utf8("5")                                                                                                                                                                                                                                                                                                                  |
|               |       TableScan: merge_left_data, partial_filters=[merge_left_data.kind = Utf8("root"), merge_left_data.k >= Utf8("1"), merge_left_data.k < Utf8("5")]                                                                                                                                                                                                                                                                                |
|               | ]]                                                                                                                                                                                                                                                                                                                                                                                                                                    |
|               |       MergeScan [is_placeholder=false, remote_input=[                                                                                                                                                                                                                                                                                                                                                                                 |
|               | SubqueryAlias: c                                                                                                                                                                                                                                                                                                                                                                                                                      |
|               |   Projection: merge_left_data.k, count(Int64(1)) AS count(*) AS n                                                                                                                                                                                                                                                                                                                                                                     |
|               |     Aggregate: groupBy=[[merge_left_data.k]], aggr=[[count(merge_left_data.ts) AS count(Int64(1))]]                                                                                                                                                                                                                                                                                                                                   |
|               |       Filter: merge_left_data.kind = Utf8("child") AND merge_left_data.k < Utf8("4") AND merge_left_data.k IS NOT NULL                                                                                                                                                                                                                                                                                                                |
|               |         TableScan: merge_left_data, partial_filters=[merge_left_data.kind = Utf8("child"), merge_left_data.k < Utf8("4"), merge_left_data.k IS NOT NULL]                                                                                                                                                                                                                                                                              |
|               | ]]                                                                                                                                                                                                                                                                                                                                                                                                                                    |
| physical_plan | SortPreservingMergeExec: [k@0 ASC NULLS LAST]                                                                                                                                                                                                                                                                                                                                                                                         |
|               |   SortExec: expr=[k@0 ASC NULLS LAST], preserve_partitioning=[true]                                                                                                                                                                                                                                                                                                                                                                   |
|               |     HashJoinExec: mode=Partitioned, join_type=Left, on=[(k@0, k@0)], projection=[k@0, n@2]                                                                                                                                                                                                                                                                                                                                            |
|               |       RepartitionExec: partitioning=Hash([k@0], 4), input_partitions=4                                                                                                                                                                                                                                                                                                                                                                |
|               |         MergeScanExec: peers=REDACTED
|               |       RepartitionExec: partitioning=Hash([k@0], 4), input_partitions=4                                                                                                                                                                                                                                                                                                                                                                |
|               |         MergeScanExec: peers=REDACTED
|               |                                                                                                                                                                                                                                                                                                                                                                                                                                       |
+---------------+---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------+

-- Four roots, three matches, nine child rows; key 4 remains with NULL n.
SELECT r.k, c.n
FROM (SELECT k FROM merge_left_data WHERE kind = 'root' AND k >= '1' AND k < '5') r
LEFT JOIN (
  SELECT k, COUNT(*) AS n FROM merge_left_data
  WHERE kind = 'child' AND k < '4' GROUP BY k
) c ON r.k = c.k
ORDER BY r.k;

+---+---+
| k | n |
+---+---+
| 1 | 3 |
| 2 | 3 |
| 3 | 3 |
| 4 |   |
+---+---+

DROP TABLE merge_left_data;

