-- Full join: 17 roots, 16 matched roots, 48 child rows.
SELECT r.k, c.n
FROM (SELECT k FROM merge_left_data WHERE kind = 'root') r
LEFT JOIN (
  SELECT k, COUNT(*) AS n FROM merge_left_data WHERE kind = 'child' GROUP BY k
) c ON r.k = c.k
ORDER BY r.k;

