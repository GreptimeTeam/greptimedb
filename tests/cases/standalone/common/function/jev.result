	Candidate functions:
	jev(Utf8View, Utf8View)

-- Invalid criteria fail locally before any HTTP request.
SELECT jev_choice('message', 'prompt', 'not json');

Error: 3001(EngineExecuteQuery), Execution error: jev_choice criteria is not valid JSON: expected ident at line 1 column 2

SELECT jev_choice('message', 'prompt', '{}');

Error: 3001(EngineExecuteQuery), Execution error: jev_choice criteria must be a JSON object with 1 to 255 options; descriptions must be strings, objects, arrays, or null

SELECT jev_score('message', 'prompt', '["only one level"]');

Error: 3001(EngineExecuteQuery), Execution error: jev_score criteria must be a JSON array with 2 to 10 levels; descriptions must be strings, objects, or arrays

