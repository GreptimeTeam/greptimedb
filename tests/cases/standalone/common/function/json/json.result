SELECT json_to_string(json_object('host', host, 'pid', pid)) FROM json_object_src ORDER BY ts;

+------------------------------------------------------------------------------------------------+
| json_to_string(json_object(Utf8("host"),json_object_src.host,Utf8("pid"),json_object_src.pid)) |
+------------------------------------------------------------------------------------------------+
| {"host":"h1","pid":42}                                                                         |
| {"host":null,"pid":7}                                                                          |
