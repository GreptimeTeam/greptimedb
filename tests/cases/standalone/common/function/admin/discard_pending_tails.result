CREATE TABLE discard_pending_tails_test (
    host STRING PRIMARY KEY,
    val DOUBLE,
    ts TIMESTAMP TIME INDEX
) PARTITION ON COLUMNS (host) (
    host < 'm',
    host >= 'm'
) ENGINE = mito;

