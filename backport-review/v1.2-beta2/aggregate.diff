+// rows of information_schema.flow_statistics
+pub const FLOW_ID: &str = "flow_id";
+pub const FLOW_NAME: &str = "flow_name";
+pub const START_TIME: &str = "start_time";
+pub const LAST_EXECUTION_TIME: &str = "last_execution_time";
