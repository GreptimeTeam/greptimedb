+
+        let submitted = procedure_executor.submitted.lock().unwrap();
+        assert_eq!(
+            submitted.len(),
+            1,
+            "expected one create table task, got {submitted:?}"
+        );
+        assert!(matches!(&submitted[0], DdlTask::CreateTable(_)));
+        Ok(())
+    }
 }
