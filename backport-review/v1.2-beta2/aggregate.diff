+        };
+        let target_type = DataType::Timestamp(TimeUnit::Nanosecond, None);
+
+        for literal in ["1970-01-01", "-8-01-01 00:00:01.5"] {
+            assert_eq!(
+                converter
+                    .convert_literal(&ScalarValue::Utf8(Some(literal.to_string())), &target_type,),
+                None
+            );
+        }
+    }
+}
