+        let utf8view_pks = modified_utf8view
+            .column(0)
+            .as_any()
+            .downcast_ref::<BinaryArray>()
+            .unwrap();
+        for row in 0..utf8_pks.len() {
+            assert_eq!(utf8_pks.value(row), utf8view_pks.value(row));
+        }
