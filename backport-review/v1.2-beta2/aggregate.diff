+                extensions: HashMap::from([("response-extension".to_string(), b"value".to_vec())]),
+                ..Default::default()
+            },
+        ))
+        .await
+        .unwrap();
+    assert!(!suspend_state.load(Ordering::Acquire));
+
+    let response = HeartbeatResponse {
+        mailbox_message: Some(MailboxMessage {
+            payload: Some(Payload::Json(
